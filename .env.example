APP_NAME=CardioPulse
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8700

APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_DE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
# Abmeldung nach 120 Min ohne Anfrage (der Überwachungsscreen bleibt durch die Live-Aktualisierung angemeldet).
SESSION_LIFETIME=120
# Sitzungsdaten verschlüsselt in der Datenbank speichern.
SESSION_ENCRYPT=true
# Produktivbetrieb (HTTPS): Cookies nur über verschlüsselte Verbindungen senden.
# SESSION_SECURE_COOKIE=true
# Nur hinter einem Reverse-Proxy setzen (IP-Adressen kommagetrennt oder *).
# TRUSTED_PROXIES=
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Lokal landen E-Mails (z. B. „Passwort vergessen“) in storage/logs/laravel.log.
# Produktivbetrieb (netcup): Postfach im Panel anlegen, dann
# MAIL_MAILER=smtp, MAIL_SCHEME=smtps, MAIL_PORT=465, MAIL_HOST/USERNAME/PASSWORD/FROM_ADDRESS laut Panel.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# CardioPulse
CARDIOPULSE_PRIVACY_LOCK_SECONDS=180
CARDIOPULSE_POLL_INTERVAL_MS=5000
CARDIOPULSE_DEMO=true
